{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Juniper",
  "version": "0.4.0-alpha.1",
  "identifier": "com.cinqic.juniper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Juniper",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "runtime/*": "runtime/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Productivity",
    "shortDescription": "Your AI, your models, your machine.",
    "longDescription": "A local-first AI environment that turns compatible models into personal Juniper assistants.",
    "publisher": "Cinqic",
    "targets": ["deb", "appimage", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 4001
    },
    "windows": {
      "wix": {
        "version": "0.4.0.1",
        "upgradeCode": "c76ebe12-b9ae-59ab-b99e-c4b6dcd55238"
      }
    }
  }
}
